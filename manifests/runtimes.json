[
  {
    "id": "Microsoft.VCRedist.2015+.x64",
    "name": "Visual C++ 2015-2022 Redistributable (x64)",
    "category": "System Dependency",
    "type": "hybrid",
    "priority": 0,
    "wingetId": "Microsoft.VCRedist.2015+.x64",
    "registryPattern": "Visual C\\+\\+ (2015-2022|v14).*Redistributable.*x64",
    "pathCheck": "C:\\Windows\\System32\\vcruntime140.dll",
    "directUrl": "https://aka.ms/vs/17/release/vc_redist.x64.exe",
    "directArgs": "/passive /norestart",
    "installType": "exe",
    "description": "Pustaka runtime C++ wajib dari Microsoft untuk menjalankan PHP, Apache, Python, dan software modern tanpa error DLL."
  },
  {
    "id": "Git.Git",
    "name": "Git for Windows",
    "category": "Version Control",
    "type": "hybrid",
    "priority": 3,
    "wingetId": "Git.Git",
    "registryPattern": "Git (version|for Windows)",
    "pathCheck": "C:\\Program Files\\Git\\cmd\\git.exe",
    "verifyCommand": "git",
    "verifyArgs": ["--version"],
    "directUrl": "https://github.com/git-for-windows/git/releases/download/v2.47.1.windows.1/Git-2.47.1-64-bit.exe",
    "directArgs": "/VERYSILENT /NORESTART /NOCANCEL /SP-",
    "installType": "exe",
    "fileName": "Git-2.47.1-64-bit.exe",
    "description": "Sistem kontrol versi resmi terdistribusi untuk melacak perubahan kode sumber."
  },
  {
    "id": "EclipseAdoptium.Temurin.21.JDK",
    "name": "Java SDK (Temurin OpenJDK 21 LTS)",
    "category": "SDK & Runtime",
    "type": "hybrid",
    "priority": 4,
    "wingetId": "EclipseAdoptium.Temurin.21.JDK",
    "registryPattern": "(Temurin.*21|OpenJDK.*21|Java.*21)",
    "minVersion": "21.0",
    "pathCheck": "C:\\Program Files\\Eclipse Adoptium\\jdk-*\\bin\\java.exe",
    "verifyCommand": "java",
    "verifyArgs": ["-version"],
    "directUrl": "https://github.com/adoptium/temurin21-binaries/releases/download/jdk-21.0.5%2B11/OpenJDK21U-jdk_x64_windows_hotspot_21.0.5_11.msi",
    "directArgs": "/qn ADDLOCAL=FeatureMain,FeatureEnvironment,FeatureJarFileRunWith,FeatureJavaHome",
    "installType": "msi",
    "fileName": "OpenJDK21U-jdk_x64_windows.msi",
    "postInstallHandler": "Setup-JavaEnvironment",
    "description": "Java Development Kit (JDK) resmi dengan dukungan LTS. Wajib untuk NetBeans & Android/Flutter."
  },
  {
    "id": "Python.Python.3.12",
    "name": "Python 3.12",
    "category": "Programming Runtime",
    "type": "hybrid",
    "priority": 5,
    "wingetId": "Python.Python.3.12",
    "registryPattern": "Python 3\\.(11|12)",
    "minVersion": "3.11",
    "pathCheck": "C:\\Program Files\\Python312\\python.exe",
    "installOverride": "/passive InstallAllUsers=1 PrependPath=1",
    "verifyCommand": "python",
    "verifyArgs": ["--version"],
    "directUrl": "https://www.python.org/ftp/python/3.12.8/python-3.12.8-amd64.exe",
    "directArgs": "/passive InstallAllUsers=1 PrependPath=1",
    "installType": "exe",
    "fileName": "python-3.12.8-amd64.exe",
    "postInstallHandler": "Setup-PythonEnvironment",
    "description": "Bahasa pemrograman tingkat tinggi untuk AI, scripting, dan backend development."
  },
  {
    "id": "OpenJS.NodeJS.LTS",
    "name": "Node.js (LTS)",
    "category": "Frontend & JS Runtime",
    "type": "hybrid",
    "priority": 7,
    "wingetId": "OpenJS.NodeJS.LTS",
    "registryPattern": "Node\\.js",
    "minVersion": "20.0",
    "pathCheck": "C:\\Program Files\\nodejs\\node.exe",
