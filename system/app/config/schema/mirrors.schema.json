{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MirrorsSchema",
  "type": "object",
  "required": ["version", "files"],
  "properties": {
    "version": { "type": "string" },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["appId", "filename", "size", "sha256", "gdriveFileIds"],
        "properties": {
          "appId": { "type": "string" },
          "filename": { "type": "string" },
          "size": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string" },
          "hashDariAdmin": { "type": "boolean" },
          "gdriveFileIds": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1,
            "maxItems": 4
          }
        }
      }
    }
  }
}
